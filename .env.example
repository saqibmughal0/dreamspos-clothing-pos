# Environment Configuration for DreamsPOS

# Server
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL="mysql://root:rootpassword@localhost:3306/dreamspos?schema=public"

# Authentication Secrets (Replace in production with secure random strings)
JWT_SECRET="dreamspos-super-secret-jwt-key-min-32-chars-long"
JWT_REFRESH_SECRET="dreamspos-super-secret-refresh-key-min-32-chars-long"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Uploads
UPLOAD_DIR="uploads"
MAX_FILE_SIZE_MB=10

# Third-Party Test Integrations (Optional)
STRIPE_SECRET_KEY="sk_test_mock_stripe_key"
TWILIO_ACCOUNT_SID="AC_mock_twilio_account_sid"
TWILIO_AUTH_TOKEN="mock_twilio_auth_token"
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="mock_smtp_user"
SMTP_PASS="mock_smtp_pass"
