# ==============================================================================
# MR BILAL POS — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Server Environment
NODE_ENV=production
PORT=5000
FRONTEND_URL=https://dreamspos-clothing-pos.vercel.app

# Database (Railway MySQL or external MySQL)
DATABASE_URL="mysql://root:password@roundhouse.proxy.rlwy.net:3306/railway"

# Authentication & Session Security (Use 64-character random hex keys in production)
JWT_SECRET="generate_a_64_char_secure_random_string_for_jwt_signing"
JWT_REFRESH_SECRET="generate_a_separate_64_char_secure_random_string_for_refresh"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Google OAuth 2.0 (Google Cloud Console > Credentials > OAuth 2.0 Client IDs)
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
VITE_GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"

# SMTP Transactional Email Configuration (Required in Production)
# Examples: SendGrid, Mailgun, Amazon SES, Brevo, or Gmail App Password
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="apikey"
SMTP_PASS="SG.your_sendgrid_api_key_here"
SMTP_FROM="MR Bilal POS <noreply@mrbilal.com>"

# Persistent Profile Avatar Storage (Required for Production on Railway)
# Option A: S3 / Cloudflare R2 / MinIO
AWS_S3_BUCKET="mrbilal-avatars"
AWS_ACCESS_KEY_ID="your-s3-or-r2-access-key-id"
AWS_SECRET_ACCESS_KEY="your-s3-or-r2-secret-access-key"
AWS_REGION="us-east-1"
# For Cloudflare R2 or MinIO, specify endpoint; leave empty for standard AWS S3:
AWS_S3_ENDPOINT=""

# Option B: Cloudinary (Alternative persistent image storage)
CLOUDINARY_URL=""

# Local Uploads Directory (Used as local fallback in development)
UPLOAD_DIR="uploads"
