{
  "name": "@dreamspos/database",
  "version": "1.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "npm run prisma:generate && tsc",
    "prisma:generate": "node -e \"process.env.PRISMA_GENERATE_SKIP_AUTOINSTALL='true'; require('child_process').execSync('prisma generate', {stdio: 'inherit', env: process.env})\"",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy --schema=prisma/schema.prisma",
    "prisma:seed": "ts-node seed/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1",
    "bcrypt": "^5.1.1",
    "prisma": "^6.3.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.13.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
